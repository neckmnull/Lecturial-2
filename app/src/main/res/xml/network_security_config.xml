<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only, trusting the system's certificate authorities alone: none added by the user or a device profile. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Debug builds also trust user certificates, so their traffic can be inspected through a proxy. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
