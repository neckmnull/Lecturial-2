<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_status_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_tile_background"
    android:clickable="true"
    android:focusable="false"
    android:minHeight="64dp"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/widget_status_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/widget_load_error"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_status_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/widget_load_error_hint"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="10sp" />
</LinearLayout>